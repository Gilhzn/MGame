{
  "name": "mgame",
  "private": true,
  "version": "0.1.0",
  "description": "Project Overlord — hybrid RTS/FPS battler monorepo",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/protocol && tsc -p packages/sim && tsc -p packages/server",
    "dev:server": "npm run dev -w @overlord/server",
    "golden": "npm run golden -w @overlord/sim"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
