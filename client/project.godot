; Project Overlord — Godot 4.3 (C#) mobile client
config_version=5

[application]

config/name="Project Overlord"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.4", "C#", "Mobile")
config/icon="res://icon.svg"

[autoload]

AuthService="*res://autoload/AuthService.cs"
LiveOpsConfigService="*res://autoload/LiveOpsConfigService.cs"
NetworkClient="*res://autoload/NetworkClient.cs"
GameState="*res://autoload/GameState.cs"
AudioListenerSwitchManager="*res://autoload/AudioListenerSwitchManager.cs"
SceneRouter="*res://autoload/SceneRouter.cs"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="MGame.Client"

[input]

